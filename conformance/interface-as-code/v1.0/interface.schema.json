{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/interface-as-code/main/spec/v1.0/interface.schema.json",
  "title": "Interface as Code specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "interface", "trigger", "contract", "delivery", "mapping", "retry", "monitoring", "reconciliation"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "interface": {"type": "object", "additionalProperties": false, "required": ["id", "name", "source", "target", "mode"], "properties": {"id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"}, "name": {"type": "string", "minLength": 3}, "description": {"type": "string"}, "source": {"$ref": "#/$defs/endpoint"}, "target": {"$ref": "#/$defs/endpoint"}, "consumers": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}, "minItems": 1, "uniqueItems": true}, "mode": {"enum": ["sync", "async", "batch"]}, "pattern": {"enum": ["request-response", "event-driven", "message-driven", "file-transfer", "scheduled-batch"]}, "criticality": {"enum": ["low", "medium", "high", "critical"]}, "lifecycle": {"enum": ["proposed", "approved", "active", "deprecated", "retired"]}, "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
    "ownership": {"type": "object", "additionalProperties": false, "properties": {"business": {"type": "string", "minLength": 2}, "technical": {"type": "string", "minLength": 2}, "support": {"type": "string", "minLength": 2}, "data": {"type": "string", "minLength": 2}}},
    "route": {"type": "object", "additionalProperties": false, "properties": {"middleware": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "hops": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}}, "external_ids": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "trigger": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"event": {"type": "string"}, "schedule": {"type": "string"}, "operation": {"type": "string"}}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["format"], "properties": {"format": {"enum": ["IDoc", "SOAP", "REST", "OData", "Kafka", "JMS", "CSV", "JSON", "XML", "EDI", "File"]}, "message_type": {"type": "string"}, "basic_type": {"type": "string"}, "schema_ref": {"type": "string"}, "content_type": {"type": "string"}, "version": {"type": "string"}, "ref": {"$ref": "#/$defs/artifactRef"}}},
    "delivery": {"type": "object", "additionalProperties": false, "required": ["guarantee", "idempotency"], "properties": {"guarantee": {"enum": ["at-most-once", "at-least-once", "effectively-once", "best-effort"]}, "ordering": {"enum": ["none", "global", "per-key"]}, "idempotency": {"type": "object", "additionalProperties": false, "required": ["required"], "properties": {"required": {"type": "boolean"}, "key": {"type": "string"}}}}},
    "mapping": {"type": "object", "additionalProperties": false, "properties": {"file": {"type": "string"}, "profile": {"type": "string"}, "notes": {"type": "string"}, "ref": {"$ref": "#/$defs/artifactRef"}}},
    "retry": {"type": "object", "additionalProperties": false, "required": ["strategy"], "properties": {"strategy": {"enum": ["none", "manual", "automatic"]}, "max_attempts": {"type": "integer", "minimum": 1}, "backoff": {"type": "string"}, "dead_letter": {"type": "string"}, "replay": {"type": "string"}}},
    "monitoring": {"type": "object", "additionalProperties": false, "required": ["owner", "support_route"], "properties": {"owner": {"type": "string", "minLength": 2}, "support_route": {"type": "string", "minLength": 2}, "signals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "business_key": {"type": "string"}}},
    "reconciliation": {"type": "object", "additionalProperties": false, "required": ["key", "frequency", "source_of_truth"], "properties": {"key": {"type": "string", "minLength": 1}, "frequency": {"type": "string", "minLength": 2}, "source_of_truth": {"type": "string", "minLength": 2}, "comparison": {"type": "string"}, "ref": {"$ref": "#/$defs/artifactRef"}}},
    "sla": {"type": "object", "additionalProperties": false, "properties": {"expected_latency": {"type": "string"}, "recovery_target": {"type": "string"}}},
    "security": {"type": "object", "additionalProperties": false, "properties": {"authentication": {"type": "string"}, "transport_encryption": {"type": "boolean"}, "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]}, "personal_data": {"type": "boolean"}, "external_exposure": {"type": "boolean"}, "secret_ref": {"type": "string"}, "certificate_ref": {"type": "string"}, "retention": {"type": "string"}}},
    "tests": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {"id": {"type": "string"}, "description": {"type": "string"}, "fixture": {"type": "string"}, "expected": {"type": "string"}, "evidence_ref": {"$ref": "#/$defs/artifactRef"}}}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "profiles": {"type": "object", "additionalProperties": false, "properties": {"sap": {"type": "object", "additionalProperties": false, "properties": {"integration_style": {"type": "string"}, "technology": {"type": "string"}, "integration_assessment_ref": {"type": "string"}, "package_id": {"type": "string"}, "iflow_id": {"type": "string"}, "aif_namespace": {"type": "string"}, "aif_interface": {"type": "string"}, "drf_outbound_implementation": {"type": "string"}, "runtime_artifact_id": {"type": "string"}}}}}
  },
  "$defs": {
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["system"], "properties": {"system": {"type": "string", "minLength": 2}, "object": {"type": "string"}, "environment": {"type": "string"}}},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["kind", "uri"], "properties": {"kind": {"enum": ["mapping-as-code", "reconciliation-as-code", "transformation-graph", "openapi", "asyncapi", "pact", "evidence", "custom"]}, "uri": {"type": "string", "minLength": 1}, "revision": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["type", "ref"], "properties": {"type": {"enum": ["test", "runtime", "design", "approval", "monitoring"]}, "ref": {"$ref": "#/$defs/artifactRef"}, "status": {"type": "string"}, "observed_at": {"type": "string"}}}
  }
}
