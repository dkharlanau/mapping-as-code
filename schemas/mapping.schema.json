{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mappingascode.dev/schema/v1alpha1/mapping.schema.json",
  "title": "Mapping as Code specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "source", "target", "fields"],
  "properties": {
    "apiVersion": {"const": "mappingascode.dev/v1alpha1"},
    "kind": {"const": "MappingSpec"},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {
      "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "description": {"type": "string"},
      "owners": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
    }},
    "source": {"$ref": "#/$defs/endpoint"}, "target": {"$ref": "#/$defs/endpoint"},
    "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}},
    "valueMaps": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {
      "from": {"type": ["string", "number", "boolean", "null"]}, "to": {"type": ["string", "number", "boolean", "null"]}
    }}}}
  },
  "$defs": {
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["system", "object"], "properties": {
      "system": {"type": "string", "minLength": 1}, "object": {"type": "string", "minLength": 1}, "key": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
    }},
    "fieldRef": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string"}}},
    "transform": {"type": "object", "additionalProperties": true, "required": ["type"], "properties": {
      "type": {"enum": ["copy", "lookup", "constant", "concat", "expression"]}, "reference": {"type": "string"}, "value": {}
    }},
    "constraints": {"type": "object", "additionalProperties": false, "properties": {
      "required": {"type": "boolean"}, "pattern": {"type": "string"}, "allowedValues": {"type": "array"}
    }},
    "field": {"type": "object", "additionalProperties": false, "required": ["id", "source", "target", "transform"], "properties": {
      "id": {"type": "string", "minLength": 1}, "source": {"$ref": "#/$defs/fieldRef"}, "target": {"$ref": "#/$defs/fieldRef"},
      "transform": {"$ref": "#/$defs/transform"}, "constraints": {"$ref": "#/$defs/constraints"}, "description": {"type": "string"},
      "allowMultipleTarget": {"type": "boolean", "default": false}
    }}
  }
}
