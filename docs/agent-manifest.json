{
  "schema_version": "1.0",
  "product": "mapping-as-code",
  "purpose": "Govern source-to-target transformation intent as a validated, reviewable, auditable contract.",
  "human_url": "https://dkharlanau.github.io/mapping-as-code/",
  "repository": "https://github.com/dkharlanau/mapping-as-code",
  "boundaries": ["not an ETL runtime", "do not invent source or target semantics", "validate before projection", "preserve deterministic outputs"],
  "capabilities": ["validate mapping contracts", "measure mapping quality and required-target coverage", "render catalogs and lineage", "compose sandboxed mapping fragments", "build release and ecosystem evidence", "project supported adjacent contracts"],
  "entrypoints": [
    {"type":"cli","command":"map-code validate <mapping.yaml> --format json"},
    {"type":"cli","command":"map-code score <mapping.yaml> --format json"},
    {"type":"cli","command":"map-code compose <composition.yaml> --output <mapping.yaml>"},
    {"type":"cli","command":"map-code lineage <mapping.yaml> --format mermaid --output <lineage.mmd>"},
    {"type":"cli","command":"map-code bundle <mapping.yaml> --output <release-bundle.json>"}
  ],
  "safe_agent_loop": ["read README and contract", "validate", "inspect quality and traceability", "generate only when requested", "return generated paths plus evidence"],
  "related": [
    {"product":"interface-as-code","relationship":"tested endpoint-safe binding through the typed mapping.ref artifact reference"},
    {"product":"reconciliation-as-code","relationship":"project a starting v1 control or provide a pinned lookup artifact for direct consumption"},
    {"product":"process-as-code","relationship":"generic mapping-artifact traceability without transform evaluation"},
    {"product":"decision-tables-as-code","relationship":"separate bounded decision rules from field transformation intent"}
  ]
}
