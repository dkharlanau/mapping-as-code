{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/mapping-as-code/schema/mapping-fragment.schema.json",
  "title": "Mapping as Code reusable fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["fragment_version", "fields"],
  "properties": {
    "fragment_version": {"const": 1},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fieldMapping"}
    },
    "value_maps": {
      "type": "object",
      "additionalProperties": {"type": "object", "additionalProperties": true}
    },
    "required_fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "target": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  },
  "$defs": {
    "fieldEndpoint": {
      "type": "object",
      "required": ["field"],
      "properties": {"field": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "transform": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["copy", "lookup", "constant", "expression", "concat", "split", "date", "number", "boolean"]},
        "reference": {"type": "string"},
        "value": {},
        "expression": {"type": "string"}
      },
      "additionalProperties": true
    },
    "fieldMapping": {
      "type": "object",
      "required": ["id", "target"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/fieldEndpoint"},
        "target": {"$ref": "#/$defs/fieldEndpoint"},
        "transform": {"$ref": "#/$defs/transform"},
        "rules": {"type": "object"},
        "business": {"type": "object"},
        "allow_multiple_sources": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  }
}
